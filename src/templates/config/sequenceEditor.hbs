<div class="flex1 flexcol animation-sequence-editor">
  <input type="hidden" name="id" value="{{sequence.id}}">
  <div class="form-group">
    <label for="{{idPrefix}}-name">{{localize
        "SPRITE-ANIMATIONS.SEQUENCEEDITOR.NAME.LABEL"
      }}</label>
    <input
      type="text"
      id="{{idPrefix}}-name"
      name="name"
      value="{{sequence.name}}"
    />
  </div>
  <div class="form-group">
    <label for="{{idPrefix}}-immediate">{{localize
        "SPRITE-ANIMATIONS.SEQUENCEEDITOR.IMMEDIATE.LABEL"
      }}</label>
    <input
      type="checkbox"
      id="{{idPrefix}}-immediate"
      name="immediate"
      {{checked sequence.immediate}}
    />
    <p class="hint">{{localize
        "SPRITE-ANIMATIONS.SEQUENCEEDITOR.IMMEDIATE.HINT"
      }}</p>
  </div>
  <div class="form-group">
    <label for="{{idPrefix}}-resetAnimation">{{localize
        "SPRITE-ANIMATIONS.SEQUENCEEDITOR.RESETANIMATION.LABEL"
      }}</label>
    <select id="{{idPrefix}}-resetAnimation" name="resetAnimation">
      <option value=""></option>
      {{selectOptions animations localize=false selected=sequence.resetAnimation}}
    </select>
    <p class="hint">{{localize
        "SPRITE-ANIMATIONS.SEQUENCEEDITOR.RESETANIMATION.HINT"
      }}</p>
  </div>


  <div class="form-group">
    <div class="flexrow">
      <div class="flex1">
        <label for="{{idPrefix}}.animations.clear">{{localize "SPRITE-ANIMATIONS.CONFIG.ADD.LABEL"}}</label>
      </div>
      <div class="flex0">
        <a data-action="addAnimation">
          <i class="fa-solid fa-plus"></i>
        </a>
      </div>
    </div>
  </div>
  <hr>
  <div class="sprite-animationsequence-list">
    <div class="sprite-animationsequence-list--header">{{localize "SPRITE-ANIMATIONS.ITEMEDITOR.ANIMATION.LABEL"}}</div>
    <div class="sprite-animationsequence-list--header">{{localize "SPRITE-ANIMATIONS.ITEMEDITOR.DELAY.LABEL"}}</div>
    <div class="sprite-animationsequence-list--header">{{localize "SPRITE-ANIMATIONS.SEQUENCEEDITOR.LOOPS"}}</div>
    <div></div>
    <div></div>
  </div>
  <div class="sprite-animationsequence-list" data-role="animation-list">
    {{#each sequence.sequence as |animation|}}
      <div class="sprite-animationsequence-list__animation{{#if (isOdd @index)}} sprite-animationsequence-list__animation--alt-row{{/if}}" data-tooltip="{{animation.tooltip}}" data-tooltip-direction="UP">
        {{ lookup ../animations animation.animation}}
      </div>
      <div class="sprite-animationsequence-list__animation{{#if (isOdd @index)}} sprite-animationsequence-list__animation--alt-row{{/if}}">
        {{durationFormat animation.delay}}
      </div>
      <div class="sprite-animationsequence-list__animation{{#if (isOdd @index)}} sprite-animationsequence-list__animation--alt-row{{/if}}">
        {{animation.loopCount}}
      </div>
      <div class="sprite-animationsequence-list__animation{{#if (isOdd @index)}} sprite-animationsequence-list__animation--alt-row{{/if}}">
        <a data-action="editAnimation" data-animation="{{animation.id}}" class="sprite-animationsequence-list__animation--vertical-center" data-tooltip="{{localize "SPRITE-ANIMATIONS.CONFIG.TOOLTIPS.EDIT" animation=(lookup ../animations animation.animation)}}">
          <i class="fa-solid fa-cogs"></i>
        </a>
      </div>
      <div class="sprite-animationsequence-list__animation{{#if (isOdd @index)}} sprite-animationsequence-list__animation--alt-row{{/if}}">
        <a data-action="removeAnimation" data-animation="{{animation.id}}" class="sprite-animationsequence-list__animation--vertical-center" data-tooltip="{{localize "SPRITE-ANIMATIONS.CONFIG.TOOLTIPS.REMOVE" animation=(lookup ../animations animation.animation)}}">
          <i class="fa-solid fa-trash"></i>
        </a>
      </div>
    {{/each}}
  </div>
</div>